{
  "name": ".json Studio",
  "build": {"dockerfile": "Dockerfile"},
  "features": {
    "ghcr.io/devcontainers/features/node:1": {"version": "22"},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {"label": ".json Remotion", "onAutoForward": "notify"}
  },
  "postCreateCommand": "bash cloud/setup.sh",
  "remoteUser": "vscode"
}
