    {
      "id": "P01",
      "startFrame": 315,
      "durationInFrames": 465,
      "voText": "Nếu đây là lần đầu tiên các cậu ăn cơm với tớ, chắc hẳn các cậu sẽ hơi ngạc nhiên khi thấy tớ luôn chọn cơm nguội, dù trên bàn vẫn có một nồi cơm mới nấu nóng hổi.",
      "imageSrc": "317e9cfb33874f3ee417.webp",
      "nativeWidth": 1920,
      "nativeHeight": 1280,
      "onScreenText": "",
      "motion": {
        "scale_from": 1.0,
        "scale_to": 1.025,
        "pan_x_px": 0,
        "pan_y_px": 0
      },
      "captionCues": [
        {
          "startFrame": 0,
          "durationInFrames": 135,
          "text": "Nếu đây là lần đầu tiên\ncác cậu ăn cơm với tớ,"
        },
        {
          "startFrame": 135,
          "durationInFrames": 105,
          "text": "chắc hẳn các cậu\nsẽ hơi ngạc nhiên"
        },
        {
          "startFrame": 240,
          "durationInFrames": 90,
          "text": "khi thấy tớ luôn chọn cơm nguội,"
        },
        {
          "startFrame": 330,
          "durationInFrames": 135,
          "text": "dù trên bàn vẫn có một\nnồi cơm mới nấu nóng hổi."
        }
      ],
      "kind": "story"
    },
    {
      "id": "P02",
      "startFrame": 780,
      "durationInFrames": 525,
      "voText": "Nó không phải sở thích. Chẳng ai có cái sở thích kỳ quái vậy cả. Ăn cơm nóng rõ ràng ngon hơn chứ. Với tớ, nó chỉ là một thói quen, mà thói quen thì thường rất khó bỏ.",
      "imageSrc": "317e9cfb33874f3ee417.webp",
      "nativeWidth": 1920,
      "nativeHeight": 1280,
      "onScreenText": "",
      "motion": {
        "scale_from": 1.0,
        "scale_to": 1.025,
        "pan_x_px": 0,
        "pan_y_px": 0
      },
      "captionCues": [
        {
          "startFrame": 0,
          "durationInFrames": 90,
          "text": "Nó không phải sở thích."
        },
        {
          "startFrame": 90,
          "durationInFrames": 120,
          "text": "Chẳng ai có cái sở\nthích kỳ quái vậy cả."
        },
        {
          "startFrame": 210,
          "durationInFrames": 105,
          "text": "Ăn cơm nóng rõ\nràng ngon hơn chứ."
        },
        {
          "startFrame": 315,
          "durationInFrames": 105,
          "text": "Với tớ, nó chỉ là một thói quen,"
        },
        {
          "startFrame": 420,
          "durationInFrames": 105,
          "text": "mà thói quen thì\nthường rất khó bỏ."
        }
      ],
      "kind": "story"
    },
    {
      "id": "P03",
      "startFrame": 1305,
      "durationInFrames": 120,
      "voText": "Cơm nguội gắn liền với thời thơ ấu của tớ.",
      "imageSrc": "ce4f7fd4c2e46725139d.webp",
      "nativeWidth": 1920,
      "nativeHeight": 1280,
      "onScreenText": "",
      "motion": {
        "scale_from": 1.0,
        "scale_to": 1.025,
        "pan_x_px": 0,
        "pan_y_px": 0
      },
      "captionCues": [
        {
          "startFrame": 0,
          "durationInFrames": 120,
          "text": "Cơm nguội gắn liền\nvới thời thơ ấu của tớ."
        }
      ],
      "kind": "story"
    },
    {
      "id": "P04",
      "startFrame": 1425,
      "durationInFrames": 660,
      "voText": "Ngày bé, cái thời mà lò vi sóng hay bất cứ thứ gì dùng để hâm nóng thức ăn vẫn còn xa lạ, tô cơm nguội luôn xuất hiện trong những bữa ăn nhà tớ. Tớ để ý bố luôn là người ăn hết tô cơm ấy, còn phần cơm nóng thì để mẹ và tớ ăn.",
      "imageSrc": "317e9cfb33874f3ee417.webp",
      "nativeWidth": 1920,
      "nativeHeight": 1280,
      "onScreenText": "",
      "motion": {
        "scale_from": 1.0,
        "scale_to": 1.025,
        "pan_x_px": 0,
        "pan_y_px": 0
      },
      "captionCues": [
        {
          "startFrame": 0,
          "durationInFrames": 105,
          "text": "Ngày bé, cái thời mà lò vi sóng"
        },
        {
          "startFrame": 105,
          "durationInFrames": 165,
          "text": "hay bất cứ thứ gì dùng để hâm\nnóng thức ăn vẫn còn xa lạ,"
        },
        {
          "startFrame": 270,
          "durationInFrames": 135,
          "text": "tô cơm nguội luôn xuất hiện\ntrong những bữa ăn nhà tớ."
        },
        {
          "startFrame": 405,
          "durationInFrames": 135,
          "text": "Tớ để ý bố luôn là\nngười ăn hết tô cơm ấy,"
        },
        {
          "startFrame": 540,
          "durationInFrames": 120,
          "text": "còn phần cơm nóng\nthì để mẹ và tớ ăn."
        }
      ],
      "kind": "story"
    },
    {
      "id": "P05",
      "startFrame": 2085,
      "durationInFrames": 150,
      "voText": "Tớ không muốn bố phải ăn cơm nguội.",
      "imageSrc": "ce4f7fd4c2e46725139d.webp",
      "nativeWidth": 1920,
      "nativeHeight": 1280,
      "onScreenText": "",
      "motion": {
        "scale_from": 1.0,
        "scale_to": 1.025,
        "pan_x_px": 0,
        "pan_y_px": 0
      },
      "captionCues": [
        {
          "startFrame": 0,
          "durationInFrames": 150,
          "text": "Tớ không muốn bố\nphải ăn cơm nguội."
        }
      ],
      "kind": "story"
    },
    {
      "id": "P06",
      "startFrame": 2235,
      "durationInFrames": 645,
      "voText": "Thế nên cứ mỗi bữa, tớ lại giành lấy phần cơm ấy, bảo rằng tớ thích ăn cơm nguội hơn. Ban đầu chỉ đơn giản là không muốn bố phải ăn phần cơm còn lại từ bữa trước. Nhưng cứ thế, bữa này qua bữa khác, nó dần trở thành thói quen.",
      "imageSrc": "ce4f7fd4c2e46725139d.webp",
      "nativeWidth": 1920,
      "nativeHeight": 1280,
      "onScreenText": "",
      "motion": {
        "scale_from": 1.0,
        "scale_to": 1.025,
        "pan_x_px": 0,
        "pan_y_px": 0
      },
      "captionCues": [
        {
          "startFrame": 0,
          "durationInFrames": 135,
          "text": "Thế nên cứ mỗi bữa, tớ lại\ngiành lấy phần cơm ấy,"
        },
        {
          "startFrame": 135,
          "durationInFrames": 105,
          "text": "bảo rằng tớ thích\năn cơm nguội hơn."
        },
        {
          "startFrame": 240,
          "durationInFrames": 105,
          "text": "Ban đầu chỉ đơn giản\nlà không muốn bố"
        },
        {
          "startFrame": 345,
          "durationInFrames": 105,
          "text": "phải ăn phần cơm\ncòn lại từ bữa trước."
        },
        {
          "startFrame": 450,
          "durationInFrames": 105,
          "text": "Nhưng cứ thế, bữa\nnày qua bữa khác,"
        },
        {
          "startFrame": 555,
          "durationInFrames": 90,
          "text": "nó dần trở thành thói quen."
        }
      ],
      "kind": "story"
    },
