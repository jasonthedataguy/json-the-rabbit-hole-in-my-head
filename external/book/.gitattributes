# Editable program files use consistent source line endings.
scripts/** text eol=lf
tests/** text eol=lf
shared/web/** text eol=lf
*.json text eol=lf
# Preserved inputs retain raw bytes, including original spacing and CRLF.
# Validate these with hashes, not whitespace rewrites.
chapters/** -text -whitespace
references/** -text -whitespace
shared/site.css -text -whitespace
shared/site.js -text -whitespace
shared/fonts/** -text -whitespace
