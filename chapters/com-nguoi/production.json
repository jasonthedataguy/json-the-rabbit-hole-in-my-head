    {
      "name": "youtube-9x16",
      "size": [
        1080,
        1920
      ],
      "segments": [
        {
          "text": "Nếu đây là lần đầu tiên các cậu ăn cơm với tớ, chắc hẳn các cậu sẽ hơi ngạc nhiên khi thấy tớ luôn chọn cơm nguội, dù trên bàn vẫn có một nồi cơm mới nấu nóng hổi.",
          "scene": "artwork/scenes/01-dinner.jpg",
          "duration": 13.0
        },
        {
          "text": "Nó không phải sở thích. Chẳng ai có cái sở thích kỳ quái vậy cả. Ăn cơm nóng rõ ràng ngon hơn chứ. Với tớ, nó chỉ là một thói quen, mà thói quen thì thường rất khó bỏ.",
          "scene": "artwork/scenes/02-lamp.jpg",
          "duration": 13.0
        },
        {
          "text": "Cơm nguội gắn liền với thời thơ ấu của tớ.",
          "scene": "artwork/scenes/03-rice-bowl.jpg",
          "duration": 5.0
        },
        {
          "text": "Ngày bé, cái thời mà lò vi sóng hay bất cứ thứ gì dùng để hâm nóng thức ăn vẫn còn xa lạ, tô cơm nguội luôn xuất hiện trong những bữa ăn nhà tớ. Tớ để ý bố luôn là người ăn hết tô cơm ấy, còn phần cơm nóng thì để mẹ và tớ ăn.",
          "scene": "artwork/scenes/04-window-city.jpg",
          "duration": 19.0
        },
        {
          "text": "Tớ không muốn bố phải ăn cơm nguội.",
          "scene": "artwork/scenes/05-child.jpg",
          "duration": 5.0
        },
        {
          "text": "Thế nên cứ mỗi bữa, tớ lại giành lấy phần cơm ấy, bảo rằng tớ thích ăn cơm nguội hơn. Ban đầu chỉ đơn giản là không muốn bố phải ăn phần cơm còn lại từ bữa trước. Nhưng cứ thế, bữa này qua bữa khác, nó dần trở thành thói quen.",
          "scene": "artwork/scenes/06-family-photo.jpg",
          "duration": 17.333
        },
        {
          "text": "Cho đến tận bây giờ.",
          "scene": "artwork/scenes/07-room.jpg",
          "duration": 5.0
        },
        {
          "text": "Thỉnh thoảng trong những bữa cơm, bố mẹ vẫn bảo:",
          "scene": "artwork/scenes/08-chopsticks.jpg",
          "duration": 5.0
        },
        {
          "text": "“Sao không ăn cơm nóng kia con, ăn cơm nguội đau dạ dày.”",
          "scene": "artwork/scenes/09-city-night.jpg",
          "duration": 5.0
        },
        {
          "text": "“Con thích ăn cơm nguội.”",
          "scene": "artwork/scenes/10-plant.jpg",
          "duration": 5.0
        }
      ]
